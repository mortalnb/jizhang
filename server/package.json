{
  "name": "jizhang-server",
  "private": true,
  "version": "0.2.0-rc.2",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "admin:create-user": "tsx src/admin.ts create-user",
    "admin:set-password": "tsx src/admin.ts set-password",
    "admin:grant-model": "tsx src/admin.ts grant-model",
    "admin:unbind-device": "tsx src/admin.ts unbind-device",
    "admin:disable-user": "tsx src/admin.ts disable-user",
    "admin:usage": "tsx src/admin.ts usage"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.6.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2",
    "vitest": "^4.0.8"
  }
}
